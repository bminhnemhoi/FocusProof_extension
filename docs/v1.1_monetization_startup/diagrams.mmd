%% ============== DIAGRAM 5 (BONUS): CREDIT FLOW ================
%% File output gợi ý: diagram_credit_flow.png
sequenceDiagram
    participant U as User
    participant E as Extension Popup
    participant B as Background Worker
    participant S as Supabase Edge Function
    participant DB as PostgreSQL
    participant AI as OpenAI GPT-4o-mini

    U->>E: Nhấn "AI Analysis (20 Credit)"
    E->>S: POST /credits/deduct (JWT + idempotency_key)
    S->>DB: SELECT plan, credits, trial_end FROM users WHERE id=:id
    DB-->>S: { plan: 'free', credits: 80, trial_end: 2026-04-25 }
    
    alt Trial còn hạn hoặc Pro/Team
        S-->>E: { ok: true, free: true }
    else Hết Trial + đủ Credit
        S->>DB: UPDATE credits = credits - 20 (atomic)
        S->>DB: INSERT credit_transactions (type='ai_single', amount=-20)
        S-->>E: { ok: true, balance: 60 }
    else Hết Trial + không đủ Credit
        S-->>E: { error: 'INSUFFICIENT_CREDITS', required: 20, current: 5 }
        E->>U: Hiển thị CreditExhaustedPopup<br/>(Mua ngay / Mời bạn / Bỏ qua)
    end
    
    E->>AI: POST /v1/chat/completions (session data)
    AI-->>E: AI analysis text
    E->>U: Hiển thị kết quả + Generate PDF Page 2
