# FocusProof backend – biến môi trường
# Sao chép thành .env rồi điền giá trị thật. TUYỆT ĐỐI không commit .env.

# development | production. Ở production, server TỪ CHỐI khởi động nếu
# CERT_SIGNING_SECRET còn để trống hoặc là giá trị mặc định.
NODE_ENV=development

# Bắt buộc để bật AI proxy (nếu bỏ trống, /api/ai-analyze trả 503 và
# extension sẽ tự dùng phân tích offline).
OPENAI_API_KEY=

# Khóa bí mật ký chứng chỉ (HMAC-SHA-256). Đổi thành chuỗi ngẫu nhiên >= 32 ký tự.
# Gợi ý: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_SIGNING_SECRET=change-me-to-a-long-random-string

# (Tùy chọn) Token bảo vệ POST /api/certificates, /api/events và GET /api/stats.
# Nếu đặt, client phải gửi header x-fp-token khớp. Bỏ trống = mở (chế độ demo).
# LƯU Ý: token nhúng trong extension chỉ là lớp chống lạm dụng, KHÔNG phải auth
# thật (ai dịch ngược extension sẽ thấy) — xem README mục "Giới hạn bảo mật".
API_TOKEN=

# URL công khai của server (dùng dựng verifyUrl trong QR).
PUBLIC_BASE_URL=http://localhost:8787

# Chỉ cho phép origin của extension/landing page ở production (siết CORS).
# Ví dụ: chrome-extension://<id>,https://focusproof.com
CORS_ORIGIN=*

PORT=8787
